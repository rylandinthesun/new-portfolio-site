<dialog id="contact-form-modal" class="modal">
  <div
    class="modal-box bg-stone-100 border-4 border-slate-800 rounded-lg max-h-none p-4 sm:p-6"
  >
    <form method="dialog">
      <button
        id="cancel-contact"
        class="btn btn-sm btn-circle btn-ghost text-sky-600 absolute right-2 top-2"
        >✕</button
      >
    </form>
    <h3 class="font-bold text-2xl sm:text-4xl font-mono text-emerald-600">
      Contact me!
    </h3>
    <p class="text-base sm:text-xl text-slate-800 mt-4">
      If you are interested in working with me, have a question, or just want to
      say hi, feel free to email me directly at <span class="font-semibold"
        >ryland.oehlers@gmail.com</span
      > or use the button below.
    </p>
    <div class="w-full flex items-center justify-end space-x-3 mt-6">
      <button
        id="cancel-contact"
        class="px-4 py-2 text-xl border-2 border-slate-800 rounded-lg text-slate-800 bg-stone-100 hover:bg-slate-200 uppercase"
        >Close</button
      >
      <a
        class="px-6 py-2 text-xl border-2 border-emerald-600 bg-emerald-600 rounded-lg text-stone-50 hover:bg-emerald-700 uppercase"
        href="mailto:ryland.oehlers@gmail.com?subject=Portfolio%20Inquiry"
        >Open email app</a
      >
    </div>
  </div>
</dialog>
