<script>
  let dialog = document.querySelector(
    "#contact-form-modal"
  ) as HTMLDialogElement;
  let contactButton = document.querySelectorAll("#contact-btn");
  let cancelButtons = document.querySelectorAll("#cancel-contact");
  let mailtoLink = document.querySelector(
    '#contact-form-modal a[href^="mailto:"]'
  ) as HTMLAnchorElement | null;

  function closeAndRestModal() {
    dialog.close();
  }

  cancelButtons?.forEach((button) => {
    button.addEventListener("click", (e) => {
      // close dialog element
      e.preventDefault();
      // set all input values to empty
      closeAndRestModal();
    });
  });

  // click outside dialog to close
  dialog?.addEventListener("click", (e) => {
    if (e.target === dialog && dialog.open) {
      closeAndRestModal();
    }
  });

  contactButton?.forEach((button) => {
    button.addEventListener("click", (e) => {
      e.preventDefault();
      dialog?.showModal();
    });
  });

  // Close the modal when user clicks the mailto button
  mailtoLink?.addEventListener("click", () => {
    // Let the browser handle opening the mail client, but close the modal immediately
    closeAndRestModal();
  });
</script>
